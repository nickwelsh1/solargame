
# Default: Auto-detect text files and enforce LF line endings
* text=auto

# Explicit text file handling
*.js       text eol=lf
*.ts       text eol=lf
*.jsx      text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Explicit binary overrides (bypasses byte-inspection to prevent corruption)
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.zip      binary
*.tar.gz   binary
